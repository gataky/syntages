# Loaded by direnv on cd. After editing this file, run `direnv allow` once.

# Python, Node and uv at the versions in .tool-versions (use_asdf lives in ~/.config/direnv/direnvrc)
use asdf

# The virtualenv uv manages; `make install` (uv sync) creates it from uv.lock
export VIRTUAL_ENV="$PWD/.venv"
PATH_add .venv/bin

watch_file .tool-versions pyproject.toml uv.lock
